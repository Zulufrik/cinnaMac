enabled-applets=['panel1:left:0:Cinnamenu@json:21', 'panel1:right:16:systray@cinnamon.org:3', 'panel1:right:17:network@cinnamon.org:10', 'panel1:right:18:sound@cinnamon.org:11', 'panel1:right:19:power@cinnamon.org:12', 'panel1:right:20:calendar@cinnamon.org:15', 'panel1:right:12:color-picker@fmete:28', 'panel1:right:11:keyboard@cinnamon.org:29', 'panel1:right:8:notifications@cinnamon.org:32', 'panel1:left:2:calendar@cinnamon.org:38']
enabled-desklets=@as []
